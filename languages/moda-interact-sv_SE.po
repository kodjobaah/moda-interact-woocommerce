msgid "The purchase could not be started."
msgstr "Köpet kunde inte startas."

#: src/page/connection-panel.js:137
msgid "The saved local connection could not be verified. Contact support for help restoring the connection."
msgstr "Den sparade lokala anslutningen kunde inte verifieras. Kontakta supporten för att få hjälp med att återställa anslutningen."

#: src/recovery-settings/recovery-settings-screen.js:13
msgid "The selected category or prompt is no longer available. Refresh the catalogue and choose an available category."
msgstr "Den valda kategorin eller prompten är inte längre tillgänglig. Uppdatera katalogen och välj en tillgänglig kategori."

#: src/overview-screen.js:182
msgid "The store overview could not be verified. Try again."
msgstr "Butiksöversikten kunde inte verifieras. Försök igen."

#: src/overview-screen.js:172
msgid "The store overview is temporarily unavailable. Your connection and store data have not been changed."
msgstr "Butiksöversikten är tillfälligt otillgänglig. Din anslutning och dina butiksuppgifter har inte ändrats."

#: src/recovery-settings/recovery-settings-screen.js:137
msgid "There are currently no selectable store categories."
msgstr "Det finns för närvarande inga butikskategorier att välja."

#: src/page/connection-panel.js:117
msgid "This WordPress site address differs from the address used for the Moda Interact connection. Contact support before changing the connection."
msgstr "Adressen till den här WordPress-webbplatsen skiljer sig från adressen som användes för anslutningen till Moda Interact. Kontakta supporten innan du ändrar anslutningen."

#: src/billing/top-up-section.js
