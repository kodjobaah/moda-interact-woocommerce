{
	"name": "moda-interact/moda-interact",
	"description": "Moda Interact WooCommerce extension",
	"autoload": {
		"psr-4": {
			"ModaInteract\\WooCommerce\\": "includes/"
		}
	},
	"scripts": {
		"lint": [
			"@php -l moda-interact.php",
			"@php -l includes/Plugin.php",
			"@php -l includes/Runtime.php",
			"@php -l includes/Api/ModaApiClient.php",
			"@php -l includes/Api/ModaApiConfiguration.php",
			"@php -l includes/Connection/BootstrapAttemptStore.php",
			"@php -l includes/Connection/ConnectionCoordinator.php",
			"@php -l includes/Connection/InstallationStore.php",
			"@php -l includes/Connection/SiteIdentity.php",
			"@php -l includes/Rest/ConnectionController.php",
			"@php -l includes/Rest/StoreContextController.php",
			"@php -l includes/StoreContext/StoreContextResolver.php",
			"@php -l includes/Security/Base64Url.php",
			"@php -l includes/Security/HmacProof.php",
			"@php -l includes/Admin/Setup.php",
			"@php -l tests/bootstrap.php",
			"@php -l tests/PluginTest.php",
			"@php -l tests/ConnectionControllerTest.php",
			"@php -l tests/ConnectionStorageAndApiTest.php",
			"@php -l tests/ModaApiConfigurationTest.php",
			"@php -l tests/SecurityAndSiteIdentityTest.php",
			"@php -l tests/StoreContextResolverTest.php",
			"@php -l tests/StoreContextControllerTest.php"
		],
		"test": "@php vendor/bin/phpunit"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"config": {
		"sort-packages": true
	}
}
