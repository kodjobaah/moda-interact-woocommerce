{
	"name": "moda-interact",
	"version": "0.1.0",
	"author": "Moda Interact",
	"license": "GPL-3.0+",
	"main": "build/index.js",
	"files": [
		"build",
		"includes",
		"languages",
		"vendor",
		"moda-interact.php",
		"readme.txt",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "wp-scripts build",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"lint:php": "composer lint",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "npm run package:production",
		"package:production": "node scripts/package-production.mjs",
		"i18n:makepot": "node scripts/make-pot.mjs",
		"i18n:compile": "node scripts/i18n/compile.mjs",
		"i18n:verify:20": "node scripts/i18n/compile.mjs --strict",
		"test:i18n": "node --test tests/i18n/*.test.mjs",
		"test:js": "wp-scripts test-unit-js tests/js && node --test tests/integration/*.test.mjs tests/i18n/*.test.mjs",
		"test:php": "composer test",
		"test:integration:wordpress": "node tests/integration/run-wordpress.mjs",
		"test:integration:package-lifecycle": "node tests/integration/run-package-lifecycle.mjs",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:start:minimum": "wp-env --config=.wp-env.minimum.json start",
		"env:stop:minimum": "wp-env --config=.wp-env.minimum.json stop",
		"start": "wp-scripts start",
		"install:php": "composer install --no-interaction"
	},
	"dependencies": {
		"@wordpress/api-fetch": "7.56.0",
		"@wordpress/date": "5.56.0",
		"@wordpress/element": "6.33.1",
		"@wordpress/hooks": "4.56.0",
		"@wordpress/i18n": "6.29.0"
	},
	"devDependencies": {
		"@woocommerce/dependency-extraction-webpack-plugin": "5.1.0",
		"@woocommerce/eslint-plugin": "4.0.0",
		"@wordpress/env": "11.16.0",
		"@wordpress/prettier-config": "4.56.0",
		"@wordpress/scripts": "36.0.0",
		"playwright": "1.63.0",
		"vite": "8.3.2",
		"vitest": "5.0.3"
	}
}
