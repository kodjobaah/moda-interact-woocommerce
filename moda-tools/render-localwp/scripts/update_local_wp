#!/usr/bin/env python3
"""Update the LocalWP WooCommerce sandbox's canonical URL for public tunnel testing.

Usage:
    update_local_wp https://your-tunnel.ngrok-free.app
    update_local_wp https://your-subdomain.loca.lt
    update_local_wp https://random-name.trycloudflare.com
    update_local_wp --status
    update_local_wp --restore
    update_local_wp URL --root '/custom/Local Sites/woocommerce-sandbox/app/public'

Only a marked block in wp-config.php is managed. A timestamped backup is created
before every actual change. No WordPress database or Moda credentials are edited.
"""

import argparse
import os
from pathlib import Path
import re
import shutil
import stat
import sys
import tempfile
from datetime import datetime
from urllib.parse import urlsplit

BEGIN = "// BEGIN MODA ARCH-036 NGROK LOCALWP"
END = "// END MODA ARCH-036 NGROK LOCALWP"
MANAGED = re.compile(r"(?m)^" + re.escape(BEGIN) + r"\r?\n.*?^" + re.escape(END) + r"\r?\n?", re.S | re.M)
WORDPRESS_BOOTSTRAP = re.compile(
    r"(?m)^[ \t]*(?:require_once|require)\s*\(?\s*ABSPATH\s*\.\s*(['\"])wp-settings\.php\1\s*\)?\s*;"
)
PREEXISTING_URL = re.compile(r"\bdefine\s*\(\s*['\"]WP_(?:HOME|SITEURL)['\"]")
DEFAULT_ROOT = Path(os.environ.get(
    "LOCAL_WP_ROOT", str(Path.home() / "Local Sites" / "woocommerce-sandbox" / "app" / "public")
)).expanduser()


def public_tunnel_origin(value: str) -> str:
    """Accept supported public HTTPS tunnel hosts, not arbitrary URLs or local targets."""
    url = urlsplit(value)
    host = url.hostname or ""
    if (url.scheme != "https" or not re.fullmatch(
            r"[a-z0-9-]+\.(?:ngrok-free\.app|ngrok\.app|ngrok\.io|loca\.lt|localtunnel\.me|trycloudflare\.com)", host, re.I)):
        raise ValueError("Provide an HTTPS ngrok, localtunnel or Cloudflare Quick Tunnel domain")
    if (url.username or url.password or url.port not in (None, 443) or
            url.path not in ("", "/") or url.query or url.fragment):
        raise ValueError("Use only the HTTPS tunnel origin (no path, credentials, query or fragment)")
    return "https://" + host.lower()


def make_block(origin: str) -> str:
    return (
        f"{BEGIN}\n"
        "// Development tunnel only. Remove with: update_local_wp --restore\n"
        f"define('WP_HOME', '{origin}');\n"
        f"define('WP_SITEURL', '{origin}');\n"
        "// The public tunnel terminates TLS before forwarding the request to LocalWP.\n"
        "if (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) &&\n"
        "    $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https') {\n"
        "    $_SERVER['HTTPS'] = 'on';\n"
        "    $_SERVER['SERVER_PORT'] = '443';\n"
        "}\n"
        f"{END}\n"
    )


def backup_and_replace(config: Path, new_text: str) -> Path:
    timestamp = datetime.now().strftime("%Y%m%d-%H%M%S")
    backup = config.with_name(config.name + ".bak-moda-" + timestamp)
    index = 1
    while backup.exists():
        backup = config.with_name(config.name + ".bak-moda-" + timestamp + f"-{index}")
        index += 1
    shutil.copy2(config, backup)
    permissions = stat.S_IMODE(config.stat().st_mode)
    temp_name = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", encoding="utf-8", dir=config.parent,
                                         prefix=".wp-config-moda-", delete=False, newline="") as handle:
            temp_name = handle.name
            handle.write(new_text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temp_name, permissions)
        os.replace(temp_name, config)
    finally:
        if temp_name and os.path.exists(temp_name):
            os.unlink(temp_name)
    return backup


def execute(args: argparse.Namespace) -> int:
    root = Path(args.root).expanduser().resolve()
    config = root / "wp-config.php"
    if not config.is_file() or config.is_symlink():
        print(f"ERROR: Cannot find a regular wp-config.php at {config}", file=sys.stderr)
        print("Use --root '/path/to/Local Sites/woocommerce-sandbox/app/public'", file=sys.stderr)
        return 2
    old = config.read_text(encoding="utf-8")
    matches = list(MANAGED.finditer(old))
    if len(matches) > 1 or old.count(BEGIN) != len(matches) or old.count(END) != len(matches):
        print("ERROR: Incomplete or duplicate managed block; inspect wp-config.php manually.", file=sys.stderr)
        return 2
    current = matches[0] if matches else None
    if args.status:
        if current:
            match = re.search(r"define\('WP_HOME', '([^']+)'\)", current.group())
            print("Managed tunnel URL:", match.group(1) if match else "(unknown)")
        else:
            print("No managed tunnel override in", config)
        return 0
    if args.restore:
        if not current:
            print("Nothing to restore; no managed ngrok override exists.")
            return 0
        revised = old[:current.start()] + old[current.end():]
    else:
        origin = public_tunnel_origin(args.url)
        unmanaged = old[:current.start()] + old[current.end():] if current else old
        if PREEXISTING_URL.search(unmanaged):
            print("ERROR: wp-config.php already defines WP_HOME/WP_SITEURL outside the managed block.", file=sys.stderr)
            print("Resolve those definitions rather than adding conflicting ones.", file=sys.stderr)
            return 2
        if current:
            replacement = make_block(origin)
            revised = old[:current.start()] + replacement + old[current.end():]
        else:
            anchor = WORDPRESS_BOOTSTRAP.search(old)
            if not anchor or "<?php" not in old:
                print("ERROR: Could not locate WordPress bootstrap in wp-config.php; no changes made.", file=sys.stderr)
                return 2
            revised = old[:anchor.start()] + make_block(origin) + old[anchor.start():]
    if revised == old:
        print("Already configured; no changes made.")
        return 0
    backup = backup_and_replace(config, revised)
    if args.restore:
        print("Restored normal WordPress URL configuration (removed managed block).")
    else:
        print("WordPress WP_HOME and WP_SITEURL now use:", origin)
    print("Configuration:", config)
    print("Backup:", backup)
    print("Keep the tunnel running with its LocalWP host-header routing.")
    print("Note: Changing canonical identity may require a new Moda installation/read authorisation.")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("url", nargs="?", help="Public HTTPS ngrok, localtunnel or Cloudflare Quick Tunnel origin")
    parser.add_argument("--root", default=str(DEFAULT_ROOT), help="LocalWP WordPress app/public directory")
    mode = parser.add_mutually_exclusive_group()
    mode.add_argument("--restore", action="store_true", help="Remove only this script's managed override")
    mode.add_argument("--status", action="store_true", help="Display the current managed override")
    args = parser.parse_args()
    if not args.restore and not args.status and not args.url:
        parser.error("Provide <tunnel_url>, or use --status / --restore")
    if (args.restore or args.status) and args.url:
        parser.error("--status and --restore do not take a URL")
    try:
        return execute(args)
    except (OSError, UnicodeError, ValueError) as exc:
        print("ERROR:", exc, file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
